# ── Secrets & quick overrides (copy to .env) ─────────────────────────────
# Semua opsional. Tanpa TELEGRAM_BOT_TOKEN bot tetap jalan (headless, log console).

# Telegram
TELEGRAM_BOT_TOKEN=
# Chat ID tujuan notifikasi (pisahkan dengan koma). Kosongkan => pakai chat yang /start ke bot.
TELEGRAM_CHAT_IDS=

# Data / execution overrides (menimpa config.yaml)
SPOT_SOURCE=binance
START_BALANCE=1000
STAKE_USDC=5
MIN_LEAD_BPS=6
MAX_EFF_PRICE=0.90
FLIP_EXIT_BPS=7
LOG_LEVEL=INFO
